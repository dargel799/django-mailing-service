# Django
DEBUG=True
SECRET_KEY=replace-with-a-new-random-secret-key
SITE_DOMAIN=127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Email (replace placeholders to send real email)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password
EMAIL_TIMEOUT=10

# Redis cache and Celery
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# PostgreSQL
POSTGRES_DB=mailings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Used only by the custom `csu` management command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
